#!/usr/bin/env bash

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
total1=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle1=$((idle + iowait))

iface="$(ip route show default 2>/dev/null | awk 'NR == 1 { print $5 }')"
sleep 0.25

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
total2=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle2=$((idle + iowait))
cpu="$(awk -v total="$((total2 - total1))" -v idle="$((idle2 - idle1))" \
    'BEGIN { if (total > 0) printf "%.1f", 100 * (total - idle) / total; else print "0.0" }')"
load="$(cut -d ' ' -f 1-3 /proc/loadavg)"

read -r _ mem_total mem_used _ < <(free -b | awk '/^Mem:/ {print $1, $2, $3, $4}')
read -r _ swap_total swap_used _ < <(free -b | awk '/^Swap:/ {print $1, $2, $3, $4}')
mem_used="$(numfmt --to=iec-i --suffix=B "$mem_used")"
mem_total="$(numfmt --to=iec-i --suffix=B "$mem_total")"
swap_used="$(numfmt --to=iec-i --suffix=B "$swap_used")"
swap_total="$(numfmt --to=iec-i --suffix=B "$swap_total")"

read -r disk_used disk_total disk_percent < <(df -h --output=used,size,pcent / | tail -1)

temperature="$(awk 'BEGIN { max = 0 } { if ($1 > max) max = $1 } END { printf "%.0f", max / 1000 }' /sys/class/thermal/thermal_zone*/temp 2>/dev/null)"
temperature="${temperature:-?}"

printf 'CPU:     %s%%  (load %s)\n' "$cpu" "$load"
printf 'Memory:  %s / %s  |  Swap: %s / %s\n' "$mem_used" "$mem_total" "$swap_used" "$swap_total"
printf 'Disk /:  %s / %s  (%s)\n' "$disk_used" "$disk_total" "$disk_percent"
printf 'Temp:    %s°C\n' "$temperature"

if [[ -n "$iface" ]]; then
    read -r rx tx < <(awk -v dev="$iface:" '$1 == dev { print $2, $10 }' /proc/net/dev)
    rx="$(numfmt --to=iec-i --suffix=B "${rx:-0}")"
    tx="$(numfmt --to=iec-i --suffix=B "${tx:-0}")"
    printf 'Network: %s  RX %s  TX %s\n' "$iface" "$rx" "$tx"
fi

read -r pid name process_cpu process_mem < <(ps -eo pid=,comm=,%cpu=,%mem= --sort=-%cpu | head -1)
printf 'Top:     %s (PID %s)  CPU %s%%  RAM %s%%\n' "$name" "$pid" "$process_cpu" "$process_mem"
